{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "group-budget",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // One Worker serves both the API and the built web app, so everything is same-origin
  // (no CORS; session cookies just work). Only /api/* runs Worker code; every other path is
  // answered straight from the static assets, with unknown paths falling back to index.html.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The production database (created with `wrangler d1 create group-budget --location apac`).
  // An id is an identifier, not a secret. Local development and the tests use a simulated D1
  // and ignore this value. The deploy job in CI skips itself while this is still the all-zero
  // placeholder.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "group-budget",
      "database_id": "14372415-7a42-4e47-b822-69b8f4e98473",
      "migrations_dir": "drizzle"
    }
  ],

  // Hourly job: turns recurring expenses that have come due into expenses (UTC; the job itself
  // works in India's calendar day). One run is one Worker invocation, so it stays small.
  "triggers": { "crons": ["0 * * * *"] },

  // Non-secret configuration. Anything unset here defaults to the safe production value;
  // local development opts in to development behaviour through .dev.vars (see .dev.vars.example).
  "vars": { "APP_VERSION": "dev" }
}
