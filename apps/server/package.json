{
  "name": "@budget/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../web/dist && wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false > /dev/null && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "e2e:server": "wrangler d1 migrations apply DB --local --persist-to .wrangler/e2e && wrangler dev --port 8787 --persist-to .wrangler/e2e --var ENVIRONMENT:development --var ENABLE_DEV_LOGIN:1 --var LOG_LEVEL:warn"
  },
  "dependencies": {
    "@budget/shared": "^0.1.0",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "drizzle-kit": "^0.31.11",
    "vitest": "^4.1.0",
    "wrangler": "^4.146.0"
  }
}
