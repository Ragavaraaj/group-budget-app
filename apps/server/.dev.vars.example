# Copy to .dev.vars (gitignored) for local `wrangler dev`. Real secrets for a deployed Worker are
# set with `wrangler secret put <NAME>`, never committed.
ENVIRONMENT=development
LOG_LEVEL=debug

# Development-only sign-in: type any email, or use the stand-in for Google's screen. It is
# impossible to enable in production (ENVIRONMENT defaults to production). See docs/auth.md.
ENABLE_DEV_LOGIN=1

# Real Google sign-in (optional locally; needed in production as Worker secrets):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Emails allowed to create an account without a group invite (comma-separated):
# ALLOWED_EMAILS=you@example.com
