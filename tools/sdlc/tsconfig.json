{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node runs these files directly (type stripping), so imports carry their .ts extension and
    // only syntax that can be erased is allowed (no enums, no parameter properties).
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src", "test"]
}
