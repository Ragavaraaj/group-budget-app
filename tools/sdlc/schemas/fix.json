{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "resolved_thread_ids", "replies", "bug_issues"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["fixed", "flaky", "unrelated", "bug_reported", "needs_human"]
    },
    "summary": { "type": "string" },
    "resolved_thread_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ids (from threads.json) of threads the pushed commits address."
    },
    "replies": {
      "type": "array",
      "description": "One reply per thread handled: the fix and its commit, or why it stays as it is. The pipeline posts them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["comment_id", "body"],
        "properties": {
          "comment_id": {
            "type": "integer",
            "description": "The id of the thread's first comment (from threads.json)."
          },
          "body": { "type": "string" }
        }
      }
    },
    "bug_issues": { "type": "array", "items": { "type": "integer" } }
  }
}
