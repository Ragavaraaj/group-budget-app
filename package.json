{
  "name": "group-budget-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run db:migrate:local && concurrently -k -n worker,web -c blue,green \"npm run dev -w @budget/server\" \"npm run dev -w @budget/web\"",
    "build": "npm run build -w @budget/web && npm run build -w @budget/server",
    "deploy": "npm run build -w @budget/web && npm run deploy -w @budget/server",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run build && playwright test",
    "e2e:webkit": "npm run build && playwright test --project=mobile-webkit",
    "check:ts-only": "! git ls-files '*.js' '*.jsx' '*.mjs' '*.cjs' | grep .",
    "check:test-layout": "! git ls-files '*/src/*.test.ts' '*/src/*.spec.ts' | grep .",
    "check:bug-refs": "node tools/sdlc/src/cli.ts check-bug-refs",
    "lint:claude": "node tools/sdlc/src/cli.ts lint-claude",
    "db:generate": "npm run db:generate -w @budget/server",
    "db:migrate:local": "npm run db:migrate:local -w @budget/server"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "overrides": {
    "undici": "^7.29.1",
    "sharp": "^0.35.4",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
