# Caddy: automatic HTTPS, serves the built web app, proxies /api to the Node server.
# DOMAIN comes from the environment (see docker-compose.yml), e.g. budget.example.com

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://lh3.googleusercontent.com; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# API -> Node. flush_interval -1 streams responses immediately (needed for the SSE endpoint).
	handle /api/* {
		reverse_proxy app:3000 {
			flush_interval -1
		}
	}

	# Everything else is the static web app, with SPA fallback to index.html.
	handle {
		root * /srv/web

		# These decide which version of the app a user gets: always revalidate them,
		# otherwise installed PWAs can get stuck on an old build.
		@shell path / /index.html /sw.js /manifest.webmanifest /registerSW.js /workbox-*.js
		header @shell Cache-Control "no-cache"

		# Hashed build output never changes, so cache it forever.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
